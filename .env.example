# ---------------------------------------------------------------------------
# Copy to .env and fill in ONE llm provider. Everything else has a default.
# ---------------------------------------------------------------------------

# --- LLM (pick one) --------------------------------------------------------
# Free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Alternative if you hit Gemini rate limits: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Alternative for fully local/air-gapped operation (requires a running ollama)
# OLLAMA_ENABLED=1
# OLLAMA_BASE_URL=http://localhost:11434

# Force a single provider instead of walking the fallback chain
# RIA_LLM_PROVIDER=gemini

# --- Warehouse -------------------------------------------------------------
# offline  = DuckDB mirror of thelook_ecommerce, generated locally, no cloud needed
# bigquery = the real bigquery-public-data.thelook_ecommerce
RIA_WAREHOUSE=offline

# Required only when RIA_WAREHOUSE=bigquery (the project that gets billed;
# the dataset itself is public).
# GOOGLE_CLOUD_PROJECT=my-gcp-project
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Golden bucket ---------------------------------------------------------
# Force the deterministic offline embedder instead of Gemini embeddings.
# RIA_EMBEDDINGS=hashing

# --- PII -------------------------------------------------------------------
# Stable salt for pseudonymous customer ids. Without it a random per-process
# salt is used, so ids are stable within a session but not across restarts.
# PII_HASH_SALT=change-me-in-production
